{
    "description": "Playwright end-to-end tests for CareerForce Drupal",
    "devDependencies": {
        "@eslint/js": "^9.0.0",
        "@playwright/test": "^1.55.0",
        "@types/node": "^26.6.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.2.1",
        "dotenv": "^18.0.9",
        "eslint": "^9.0.0",
        "eslint-plugin-playwright": "^2.0.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "prettier": "^3.0.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-router": "^8.5.1",
        "typescript": "^5.6.0",
        "typescript-eslint": "^8.0.0",
        "vite": "^8.3.6"
    },
    "name": "careerforce-playwright",
    "private": true,
    "scripts": {
        "install:browsers": "playwright install chromium",
        "login:manual": "node scripts/login-manual.mjs",
        "browser": "node scripts/open-browser.mjs",
        "test": "playwright test",
        "test:smoke": "playwright test --project=smoke-desktop --project=smoke-mobile",
        "dashboard": "node dashboard/server/index.mjs",
        "dashboard:dev": "node dashboard/server/index.mjs --dev",
        "test:debug": "playwright test --debug",
        "test:report": "playwright show-report",
        "test:ui": "playwright test --ui",
        "format": "prettier --write \"**/*.{ts,md}\"",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "typecheck": "tsc --noEmit && tsc --noEmit -p dashboard"
    },
    "version": "0.1.0"
}
