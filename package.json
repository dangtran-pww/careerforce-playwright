{"description":"Starter Playwright end-to-end tests for Dang's CareerForce Drupal (staging only for destructive tests)","devDependencies":{"@eslint/js":"^9.0.0","@playwright/test":"^1.55.0","dotenv":"^18.0.9","eslint":"^9.0.0","eslint-plugin-playwright":"^2.0.0","prettier":"^3.0.0","typescript":"^5.6.0","typescript-eslint":"^8.0.0"},"name":"careerforce-drupal-playwright-starter","private":true,"scripts":{"format":"prettier --write \"**/*.{ts,md}\"","install:browsers":"playwright install chromium","lint":"eslint .","lint:fix":"eslint . --fix","test":"playwright test","test:debug":"playwright test --debug","test:report":"playwright show-report","test:ui":"playwright test --ui","typecheck":"tsc --noEmit"},"version":"0.1.0"}