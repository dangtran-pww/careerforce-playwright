{
    "description": "Playwright end-to-end tests for CareerForce Drupal",
    "devDependencies": {
        "@playwright/test": "^1.55.0",
        "dotenv": "^18.0.9",
        "typescript": "^5.6.0",
        "@eslint/js": "^9.0.0",
        "@types/node": "^22.0.0",
        "eslint": "^9.0.0",
        "eslint-plugin-playwright": "^2.0.0",
        "prettier": "^3.0.0",
        "tsx": "^4.19.0",
        "typescript-eslint": "^8.0.0"
    },
    "name": "careerforce-playwright",
    "private": true,
    "scripts": {
        "auth": "tsx scripts/save-auth.ts",
        "install:browsers": "playwright install chromium",
        "test": "playwright test",
        "test:debug": "playwright test --debug",
        "test:report": "playwright show-report",
        "test:ui": "playwright test --ui",
        "format": "prettier --write \"**/*.{ts,md}\"",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "typecheck": "tsc --noEmit"
    },
    "version": "0.1.0"
}
