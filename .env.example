# Copy this file to .env (or export these variables in CI) and fill in staging values.
# Never commit real credentials. Never point destructive tests at production.
BASE_URL=https://qa.careerforce.link
# QA/stage sit behind an HTTP Basic Auth gate in front of Drupal. Ask the team
# for the current value — it's the same prompt you'd hit opening the site in
# a browser.
BASIC_AUTH_USER=careerforce
BASIC_AUTH_PASSWORD=GetToWork
# A Basic Auth value for one environment only (QA, STAGE, SANDBOX):
# BASIC_AUTH_USER_STAGE=
# BASIC_AUTH_PASSWORD_STAGE=
# Sandbox (https://sandbox.careerforce.link) and Local
# (https://careerforcemn.ddev.site, shown only while DDEV is running) are
# built in; set these only to point them somewhere else.
# SANDBOX_URL=
# LOCAL_URL=
# Prompt cases (test-suites/README.md, Rule 2): opus unless set here,
# e.g. sonnet or haiku for a cheaper model.
# PROMPT_MODEL=sonnet
# Plans and prompts marked Parallel (test-suites/README.md, Rule 3): workers
# for a Parallel plan's tests, and how many Parallel prompts run at once.
# PARALLEL_WORKERS=4
# PROMPT_CONCURRENCY=3
# Dashboard "Explain the steps" on a test case: sonnet unless set here.
# EXPLAIN_MODEL=haiku
# Logged-in tests: run `npm run login:manual -- <role> --env <env>` and log
# in by hand (SSO) — see README. Each environment has its own login.
