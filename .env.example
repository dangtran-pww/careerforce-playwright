# Copy this file to .env (or export these variables in CI) and fill in staging values.
# Never commit real credentials. Never point destructive tests at production.
BASE_URL=https://qa.careerforce.link
DRUSH_CMD=drush
# QA/stage sit behind an HTTP Basic Auth gate in front of Drupal. Ask the team
# for the current value — it's the same prompt you'd hit opening the site in
# a browser.
BASIC_AUTH_USER=careerforce
BASIC_AUTH_PASSWORD=GetToWork
# Only needed if you use the UI-login fallback in tests/auth.setup.ts:
# TEST_EDITOR_USER=test-editor
# TEST_EDITOR_PASSWORD=
